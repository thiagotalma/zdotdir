# Run a command and choose paths/files with fzf.
# The full command is added to your history like any other.
#
# Usage:
#   f cd [OPTION]...    (hit enter, choose path)
#   f vim [OPTION]...   (hit enter, choose files)
#   f vlc [OPTION]...   (hit enter, choose files)

f() {
    # No arguments: just launch fzf
    if (( $# == 0 )); then
        fzf
        return
    fi

    local program=$1
    shift
    local -a opts=("$@")

    # Let the user pick; Esc or no match makes fzf exit non-zero
    local out
    out=$(fzf --multi) || return 1
    [[ -n $out ]] || return 1

    # Split fzf's output on newlines, one element per selection
    local -a selections=("${(@f)out}")

    # Build the command, quoting every word safely for the shell
    local -a cmd=("$program" "${opts[@]}" "${selections[@]}")
    local line=${(j: :)${(q-)cmd}}

    # Background GUI programs so the terminal stays usable
    if [[ $program == (nautilus|zathura|evince|vlc|eog|kolourpaint) ]]; then
        line+=" &"
    fi

    # Add to history, then run it
    print -s -- "$line"
    eval "$line"
}